<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Carbon Signal — Race Telemetry Workbench Styleguide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --rt-bg-canvas:#14110E;--rt-bg-surface:#1C1815;--rt-bg-raised:#241F1B;--rt-bg-overlay:#2C2620;
  --rt-bg-inset:#100D0B;--rt-bg-hover:#2A241F;--rt-bg-selected:#3A2D12;
  --rt-border-subtle:#2A241F;--rt-border-default:#3A3128;--rt-border-strong:#524537;
  --rt-grid-line:#2A2620;--rt-grid-line-major:#3A342C;
  --rt-text-primary:#F4EEE6;--rt-text-secondary:#BCB1A2;--rt-text-tertiary:#8A7F70;--rt-text-disabled:#5C544A;
  --rt-text-on-accent:#1A1206;
  --rt-accent:#F2A007;--rt-accent-hover:#FFB52E;--rt-accent-active:#D98A00;--rt-accent-muted:#3A2D12;--rt-accent-border:#6E5314;
  --rt-cursor:#F2A007;--rt-cursor-ref:#7FA6C9;
  --rt-success:#36B37E;--rt-success-bg:#13271E;--rt-warning:#E8A33D;--rt-warning-bg:#2E2310;
  --rt-danger:#E5484D;--rt-danger-bg:#2E1414;--rt-info:#5AA9E6;--rt-info-bg:#122230;
  --rt-flag-clear:#36B37E;--rt-flag-yellow:#E8C547;--rt-flag-sc:#FF9F45;--rt-flag-vsc:#FFCB6B;
  --rt-flag-red:#E5484D;--rt-flag-rain:#4F91D6;--rt-flag-drs:#57C7C2;
  --rt-ch-speed:#56B4E9;--rt-ch-throttle:#2BB079;--rt-ch-brake:#E06C2A;--rt-ch-gear:#C879B8;--rt-ch-rpm:#E6B422;--rt-ch-drs:#57C7C2;
  --rt-driver-a:#56B4E9;--rt-driver-b:#E69F00;--rt-delta-pos:#36B37E;--rt-delta-neg:#E5484D;
  --rt-font-sans:"Inter","Segoe UI",system-ui,sans-serif;
  --rt-font-mono:"JetBrains Mono","Roboto Mono",ui-monospace,monospace;
  --rt-radius-sm:3px;--rt-radius-md:5px;--rt-radius-lg:8px;--rt-radius-xl:12px;--rt-radius-pill:999px;
  --rt-elev-1:0 1px 2px rgba(0,0,0,.45);--rt-elev-2:0 2px 8px rgba(0,0,0,.5);--rt-elev-3:0 8px 24px rgba(0,0,0,.55);
  --rt-focus:0 0 0 2px rgba(242,160,7,.55);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--rt-bg-canvas);color:var(--rt-text-secondary);
  font-family:var(--rt-font-sans);font-size:14px;line-height:1.55;-webkit-font-smoothing:antialiased}
.mono{font-family:var(--rt-font-mono);font-variant-numeric:tabular-nums}
h1,h2,h3,h4{color:var(--rt-text-primary);font-weight:600;line-height:1.2;margin:0}
a{color:var(--rt-accent);text-decoration:none}
code{font-family:var(--rt-font-mono);font-size:12px;background:var(--rt-bg-inset);
  border:1px solid var(--rt-border-subtle);border-radius:4px;padding:1px 5px;color:var(--rt-text-primary)}

/* layout */
.layout{display:grid;grid-template-columns:228px 1fr;min-height:100vh}
.nav{position:sticky;top:0;align-self:start;height:100vh;overflow-y:auto;
  background:var(--rt-bg-surface);border-right:1px solid var(--rt-border-default);padding:20px 14px}
.nav .brand{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.nav .brand .mark{width:22px;height:22px;border-radius:5px;background:var(--rt-accent);
  display:grid;place-items:center;color:var(--rt-text-on-accent);font-weight:700;font-size:13px;flex:none}
.nav .brand b{color:var(--rt-text-primary);font-size:14px;font-weight:600}
.nav .ver{font-size:11px;color:var(--rt-text-tertiary);margin-bottom:18px;padding-left:32px}
.nav a{display:block;color:var(--rt-text-secondary);font-size:13px;padding:6px 10px;border-radius:5px;margin-bottom:1px}
.nav a:hover{background:var(--rt-bg-hover);color:var(--rt-text-primary)}
.nav .group{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--rt-text-tertiary);
  margin:16px 0 6px;padding-left:10px}
.main{padding:40px 48px 120px;max-width:1080px}
section{margin-bottom:56px;scroll-margin-top:24px}
.sec-head{border-bottom:1px solid var(--rt-border-default);padding-bottom:10px;margin-bottom:24px}
.sec-head h2{font-size:22px}
.sec-head p{margin:6px 0 0;color:var(--rt-text-tertiary);font-size:13px;max-width:62ch}
.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--rt-accent);
  font-weight:600;margin-bottom:8px}
.subhead{color:var(--rt-text-primary);font-size:13px;font-weight:600;margin:24px 0 12px;
  text-transform:uppercase;letter-spacing:.05em}

/* hero */
.hero{background:var(--rt-bg-surface);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-xl);padding:32px 34px;margin-bottom:48px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-40px;top:-40px;width:220px;height:220px;
  border-radius:50%;background:radial-gradient(circle,rgba(242,160,7,.10),transparent 70%)}
.hero h1{font-size:30px;letter-spacing:-.01em}
.hero .tag{display:inline-block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;
  color:var(--rt-accent);border:1px solid var(--rt-accent-border);background:var(--rt-accent-muted);
  padding:3px 10px;border-radius:var(--rt-radius-pill);margin-bottom:14px;font-weight:600}
.hero p{max-width:64ch;margin:10px 0 0;font-size:14px}
.hero .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}
.hero .chip{font-size:12px;background:var(--rt-bg-raised);border:1px solid var(--rt-border-default);
  padding:5px 11px;border-radius:var(--rt-radius-pill);color:var(--rt-text-secondary)}
.hero .chip b{color:var(--rt-text-primary);font-weight:500}

/* swatch grids */
.swatches{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.sw{background:var(--rt-bg-surface);border:1px solid var(--rt-border-default);border-radius:var(--rt-radius-md);
  overflow:hidden}
.sw .chip{height:62px}
.sw .meta{padding:8px 10px}
.sw .name{color:var(--rt-text-primary);font-size:12px;font-weight:500}
.sw .hex{font-family:var(--rt-font-mono);font-size:11px;color:var(--rt-text-tertiary);text-transform:uppercase}
.sw .note{font-size:11px;color:var(--rt-text-tertiary);margin-top:2px}

/* generic card */
.card{background:var(--rt-bg-surface);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-lg);padding:20px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.stack{display:flex;flex-direction:column;gap:14px}

/* buttons */
.btn{font-family:var(--rt-font-sans);font-size:13px;font-weight:500;border-radius:var(--rt-radius-md);
  padding:7px 14px;border:1px solid transparent;cursor:pointer;display:inline-flex;align-items:center;
  gap:7px;transition:background .12s,border-color .12s,color .12s;line-height:1.2}
.btn:focus-visible{outline:none;box-shadow:var(--rt-focus)}
.btn svg{width:15px;height:15px}
.btn-primary{background:var(--rt-accent);color:var(--rt-text-on-accent);font-weight:600}
.btn-primary:hover{background:var(--rt-accent-hover)}
.btn-primary:active{background:var(--rt-accent-active)}
.btn-secondary{background:var(--rt-bg-raised);color:var(--rt-text-primary);border-color:var(--rt-border-strong)}
.btn-secondary:hover{background:var(--rt-bg-hover);border-color:var(--rt-text-tertiary)}
.btn-ghost{background:transparent;color:var(--rt-text-secondary)}
.btn-ghost:hover{background:var(--rt-bg-hover);color:var(--rt-text-primary)}
.btn-danger{background:transparent;color:var(--rt-danger);border-color:rgba(229,72,77,.4)}
.btn-danger:hover{background:var(--rt-danger-bg)}
.btn-sm{padding:4px 10px;font-size:12px}
.btn-icon{padding:7px;width:32px;height:32px;justify-content:center}
.btn:disabled{background:var(--rt-bg-raised);color:var(--rt-text-disabled);border-color:var(--rt-border-subtle);
  cursor:not-allowed}

/* segmented control */
.seg{display:inline-flex;background:var(--rt-bg-inset);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-md);padding:2px;gap:2px}
.seg button{font-family:var(--rt-font-mono);font-size:12px;color:var(--rt-text-secondary);background:transparent;
  border:none;border-radius:3px;padding:4px 10px;cursor:pointer;transition:background .12s,color .12s}
.seg button:hover{color:var(--rt-text-primary)}
.seg button[aria-pressed="true"]{background:var(--rt-accent);color:var(--rt-text-on-accent);font-weight:500}

/* channel chips (toggle) */
.chchip{display:inline-flex;align-items:center;gap:7px;background:var(--rt-bg-raised);
  border:1px solid var(--rt-border-default);border-radius:var(--rt-radius-pill);padding:4px 12px 4px 8px;
  font-size:12px;color:var(--rt-text-secondary);cursor:pointer;user-select:none}
.chchip .dot{width:10px;height:3px;border-radius:2px;display:inline-block}
.chchip.off{opacity:.42}
.chchip.off .dot{filter:grayscale(1)}

/* inputs */
.field{display:flex;flex-direction:column;gap:5px;max-width:280px}
.field label{font-size:12px;color:var(--rt-text-tertiary)}
.input,.select{background:var(--rt-bg-inset);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-md);padding:7px 10px;color:var(--rt-text-primary);font-size:13px;
  font-family:var(--rt-font-sans);width:100%}
.input:focus,.select:focus{outline:none;border-color:var(--rt-accent);box-shadow:var(--rt-focus)}
.input::placeholder{color:var(--rt-text-disabled)}
.search{position:relative}
.search svg{position:absolute;left:9px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:var(--rt-text-tertiary)}
.search .input{padding-left:30px}

/* badges / flags / tags */
.badge{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;
  padding:3px 9px;border-radius:var(--rt-radius-pill);letter-spacing:.02em}
.badge .led{width:7px;height:7px;border-radius:50%}
.flag-clear{background:rgba(54,179,126,.14);color:var(--rt-flag-clear)}
.flag-yellow{background:rgba(232,197,71,.16);color:var(--rt-flag-yellow)}
.flag-sc{background:rgba(255,159,69,.16);color:var(--rt-flag-sc)}
.flag-vsc{background:rgba(255,203,107,.16);color:var(--rt-flag-vsc)}
.flag-red{background:rgba(229,72,77,.16);color:var(--rt-flag-red)}
.flag-rain{background:rgba(79,145,214,.16);color:var(--rt-flag-rain)}
.tyre{display:inline-flex;align-items:center;gap:6px;font-family:var(--rt-font-mono);font-size:11px;font-weight:700;
  padding:2px 8px;border-radius:var(--rt-radius-sm);border:1px solid var(--rt-border-default)}
.tyre .ring{width:10px;height:10px;border-radius:50%;border:2px solid}
.tyre-soft .ring{border-color:#E5484D}.tyre-soft{color:#E5797D}
.tyre-med .ring{border-color:#E6B422}.tyre-med{color:#E6C45F}
.tyre-hard .ring{border-color:#D9D2C6}.tyre-hard{color:#D9D2C6}
.tyre-inter .ring{border-color:#36B37E}.tyre-inter{color:#5CC698}
.tyre-wet .ring{border-color:#4F91D6}.tyre-wet{color:#73A8DE}

/* legend */
.legend{display:flex;flex-direction:column;gap:2px;font-family:var(--rt-font-mono);font-size:12px}
.legend .li{display:grid;grid-template-columns:14px 1fr auto;gap:10px;align-items:center;
  padding:5px 8px;border-radius:4px}
.legend .li:hover{background:var(--rt-bg-hover)}
.legend .li .ln{width:14px;height:0;border-top:2px solid}
.legend .li .nm{color:var(--rt-text-secondary)}
.legend .li .vl{color:var(--rt-text-primary);font-weight:500}
.legend .li .u{color:var(--rt-text-tertiary);font-size:11px}

/* numeric readouts */
.readouts{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}
.ro{background:var(--rt-bg-inset);border:1px solid var(--rt-border-subtle);border-radius:var(--rt-radius-md);
  padding:10px 12px}
.ro .k{font-size:11px;color:var(--rt-text-tertiary);text-transform:uppercase;letter-spacing:.05em}
.ro .v{font-family:var(--rt-font-mono);font-size:26px;color:var(--rt-text-primary);font-weight:500;
  line-height:1.1;margin-top:3px}
.ro .v .u{font-size:12px;color:var(--rt-text-tertiary);font-weight:400;margin-left:3px}
.ro.accent{border-color:var(--rt-accent-border)}
.ro.accent .v{color:var(--rt-accent)}

/* table */
.tbl-wrap{border:1px solid var(--rt-border-default);border-radius:var(--rt-radius-lg);overflow:hidden}
table.tbl{width:100%;border-collapse:collapse;font-size:12px}
table.tbl th{background:var(--rt-bg-raised);color:var(--rt-text-tertiary);text-align:right;
  font-weight:500;text-transform:uppercase;letter-spacing:.04em;font-size:11px;padding:8px 10px;
  border-bottom:1px solid var(--rt-border-default);position:sticky;top:0}
table.tbl th:first-child,table.tbl td:first-child{text-align:left}
table.tbl td{padding:6px 10px;text-align:right;border-bottom:1px solid var(--rt-border-subtle);
  font-family:var(--rt-font-mono);color:var(--rt-text-secondary)}
table.tbl td.lbl{font-family:var(--rt-font-sans);color:var(--rt-text-primary)}
table.tbl tr:hover td{background:var(--rt-bg-hover)}
table.tbl tr.sel td{background:var(--rt-bg-selected)}
table.tbl tr.sel td:first-child{box-shadow:inset 2px 0 0 var(--rt-accent)}
.fastest{color:var(--rt-accent);font-weight:700}

/* panels (workbench) */
.panel{background:var(--rt-bg-surface);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-lg);overflow:hidden;box-shadow:var(--rt-elev-1)}
.panel.active{border-color:var(--rt-accent-border)}
.panel-hd{display:flex;align-items:center;justify-content:space-between;background:var(--rt-bg-raised);
  padding:7px 12px;border-bottom:1px solid var(--rt-border-default)}
.panel.active .panel-hd{box-shadow:inset 2px 0 0 var(--rt-accent)}
.panel-hd .t{display:flex;align-items:center;gap:8px;color:var(--rt-text-primary);font-size:13px;font-weight:500}
.panel-hd .t .ic{color:var(--rt-text-tertiary);display:flex}
.panel-hd .tools{display:flex;gap:2px;color:var(--rt-text-tertiary)}
.panel-hd .tools button{background:none;border:none;color:inherit;cursor:pointer;padding:3px;border-radius:3px;display:flex}
.panel-hd .tools button:hover{background:var(--rt-bg-hover);color:var(--rt-text-primary)}
.panel-bd{padding:12px}

/* transport */
.transport{display:flex;align-items:center;gap:14px;background:var(--rt-bg-raised);
  border:1px solid var(--rt-border-default);border-radius:var(--rt-radius-lg);padding:10px 14px}
.transport .grp{display:flex;align-items:center;gap:4px}
.tbtn{width:34px;height:34px;border-radius:var(--rt-radius-md);border:1px solid var(--rt-border-default);
  background:var(--rt-bg-surface);color:var(--rt-text-secondary);cursor:pointer;display:grid;place-items:center}
.tbtn:hover{color:var(--rt-text-primary);border-color:var(--rt-border-strong)}
.tbtn.play{background:var(--rt-accent);border-color:var(--rt-accent);color:var(--rt-text-on-accent)}
.tbtn.play:hover{background:var(--rt-accent-hover)}
.tbtn svg{width:16px;height:16px}
.clock{font-family:var(--rt-font-mono);font-size:15px;color:var(--rt-text-primary);font-variant-numeric:tabular-nums}
.clock .sub{color:var(--rt-text-tertiary);font-size:12px}

/* seek slider */
.seek{flex:1;position:relative;height:34px;display:flex;align-items:center}
.seek .track{position:absolute;left:0;right:0;height:6px;background:var(--rt-bg-inset);
  border-radius:var(--rt-radius-pill);border:1px solid var(--rt-border-subtle);overflow:hidden}
.seek .buf{position:absolute;left:0;height:100%;background:var(--rt-border-strong);opacity:.6}
.seek .fill{position:absolute;left:0;height:100%;background:var(--rt-accent)}
/* flag overlay on seek */
.seek .fl{position:absolute;top:0;height:100%;opacity:.5}
.seek .knob{position:absolute;width:14px;height:14px;border-radius:50%;background:var(--rt-accent);
  border:2px solid var(--rt-bg-canvas);box-shadow:var(--rt-elev-1);transform:translateX(-50%)}

/* context strip */
.cstrip{height:46px;background:var(--rt-bg-inset);border:1px solid var(--rt-border-subtle);
  border-radius:var(--rt-radius-md);position:relative;overflow:hidden}
.cstrip .lap{position:absolute;top:0;bottom:18px;border-right:1px solid var(--rt-border-subtle)}
.cstrip .band{position:absolute;bottom:0;height:14px}
.cstrip .mk{position:absolute;top:3px;width:2px;height:14px;border-radius:1px}
.cstrip .cur{position:absolute;top:0;bottom:0;width:2px;background:var(--rt-cursor)}

/* event list */
.events{display:flex;flex-direction:column}
.ev{display:grid;grid-template-columns:64px 16px 1fr auto;gap:10px;align-items:center;
  padding:7px 10px;border-bottom:1px solid var(--rt-border-subtle);font-size:12px;cursor:pointer}
.ev:hover{background:var(--rt-bg-hover)}
.ev .ts{font-family:var(--rt-font-mono);color:var(--rt-text-tertiary)}
.ev .ic{width:8px;height:8px;border-radius:50%}
.ev .msg{color:var(--rt-text-secondary)}
.ev .msg b{color:var(--rt-text-primary);font-weight:500}
.ev .lap{font-family:var(--rt-font-mono);color:var(--rt-text-tertiary);font-size:11px}

/* tooltip */
.tip{display:inline-block;background:var(--rt-bg-overlay);border:1px solid var(--rt-border-strong);
  border-radius:var(--rt-radius-md);padding:8px 10px;box-shadow:var(--rt-elev-2);font-size:12px;min-width:150px}
.tip .th{color:var(--rt-text-tertiary);font-family:var(--rt-font-mono);font-size:11px;margin-bottom:5px}
.tip .tr{display:flex;justify-content:space-between;gap:16px;padding:1px 0}
.tip .tr .n{color:var(--rt-text-secondary)}
.tip .tr .v{font-family:var(--rt-font-mono);color:var(--rt-text-primary)}

/* spacing / radius demo */
.scale-row{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap}
.scale-row .it{text-align:center}
.scale-row .bar{background:var(--rt-accent-muted);border:1px solid var(--rt-accent-border);border-radius:3px}
.scale-row .lb{font-size:11px;color:var(--rt-text-tertiary);font-family:var(--rt-font-mono);margin-top:6px}
.radii{display:flex;gap:16px;flex-wrap:wrap}
.radii .rb{width:74px;height:60px;background:var(--rt-bg-raised);border:1px solid var(--rt-border-strong)}
.radii .lb{font-size:11px;color:var(--rt-text-tertiary);font-family:var(--rt-font-mono);text-align:center;margin-top:6px}
.elevs{display:flex;gap:20px;flex-wrap:wrap}
.elevs .eb{width:120px;height:72px;background:var(--rt-bg-surface);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-lg);display:grid;place-items:center;font-size:11px;color:var(--rt-text-tertiary);
  font-family:var(--rt-font-mono)}

/* type scale */
.type-row{display:flex;align-items:baseline;gap:18px;padding:9px 0;border-bottom:1px solid var(--rt-border-subtle)}
.type-row .meta{width:150px;flex:none;font-family:var(--rt-font-mono);font-size:11px;color:var(--rt-text-tertiary)}
.type-row .meta b{color:var(--rt-text-secondary);display:block;font-weight:500;font-size:12px}

.note-box{background:var(--rt-bg-raised);border:1px solid var(--rt-border-default);border-left:2px solid var(--rt-accent);
  border-radius:var(--rt-radius-md);padding:12px 14px;font-size:13px;color:var(--rt-text-secondary)}
.note-box b{color:var(--rt-text-primary);font-weight:600}
.dodont{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.dodont .col{border-radius:var(--rt-radius-md);padding:14px;font-size:13px}
.dodont .do{background:var(--rt-success-bg);border:1px solid rgba(54,179,126,.3)}
.dodont .dont{background:var(--rt-danger-bg);border:1px solid rgba(229,72,77,.3)}
.dodont h4{font-size:12px;margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em}
.dodont .do h4{color:var(--rt-success)}.dodont .dont h4{color:var(--rt-danger)}
.dodont ul{margin:0;padding-left:18px}.dodont li{margin-bottom:5px}
svg .gl{stroke:var(--rt-grid-line);stroke-width:1}
svg .glm{stroke:var(--rt-grid-line-major);stroke-width:1}
svg .axt{fill:var(--rt-text-tertiary);font-family:var(--rt-font-mono);font-size:9px}

/* tyre compound fills (gantt) */
.ty-soft{background:#E5484D}.ty-med{background:#E6B422}.ty-hard{background:#D9D2C6}
.ty-inter{background:#36B37E}.ty-wet{background:#4F91D6}
.tylegend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--rt-text-secondary);margin-bottom:14px}
.tylegend span{display:inline-flex;align-items:center;gap:6px}
.tylegend i{width:9px;height:9px;border-radius:50%;display:inline-block}

/* command palette */
.cmdk-vp{min-height:300px;background:rgba(10,8,6,.66);border-radius:var(--rt-radius-lg);
  display:flex;justify-content:center;padding-top:40px;border:1px solid var(--rt-border-default)}
.cmdk{width:min(560px,92%);height:max-content;background:var(--rt-bg-overlay);border:1px solid var(--rt-border-strong);
  border-radius:var(--rt-radius-lg);box-shadow:var(--rt-elev-3);overflow:hidden}
.cmdk-in{display:flex;align-items:center;gap:10px;padding:13px 15px;border-bottom:1px solid var(--rt-border-default)}
.cmdk-in svg{width:17px;height:17px;color:var(--rt-text-tertiary)}
.cmdk-in input{flex:1;background:none;border:none;outline:none;color:var(--rt-text-primary);font-size:15px;font-family:var(--rt-font-sans)}
.kbd{font-family:var(--rt-font-mono);font-size:10px;color:var(--rt-text-tertiary);border:1px solid var(--rt-border-default);
  border-radius:4px;padding:2px 6px;background:var(--rt-bg-raised)}
.cmdk-grp{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--rt-text-tertiary);
  padding:11px 15px 5px;display:flex;align-items:center;gap:6px}
.cmdk-row{display:flex;align-items:center;gap:12px;padding:9px 15px;cursor:pointer}
.cmdk-row.on{background:var(--rt-bg-hover)}
.cmdk-row.on{box-shadow:inset 2px 0 0 var(--rt-accent)}
.cmdk-row .fl{width:30px;height:22px;border-radius:4px;flex:none;display:grid;place-items:center;overflow:hidden;border:1px solid var(--rt-border-default)}
.cmdk-row .nm{color:var(--rt-text-primary);font-size:14px}
.cmdk-row .sub{color:var(--rt-text-tertiary);font-size:12px}
.cmdk-row .go{margin-left:auto;color:var(--rt-text-tertiary);font-size:11px;display:flex;align-items:center;gap:5px}

/* home launcher */
.launch{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.tcard{background:var(--rt-bg-surface);border:1px solid var(--rt-border-default);border-radius:var(--rt-radius-lg);
  padding:14px;cursor:pointer;transition:border-color .12s,background .12s}
.tcard:hover{border-color:var(--rt-border-strong);background:var(--rt-bg-hover)}
.tcard.sel{border-color:var(--rt-accent-border);background:var(--rt-accent-muted)}
.tcard .fl{width:34px;height:24px;border-radius:4px;border:1px solid var(--rt-border-default);overflow:hidden;margin-bottom:10px}
.tcard .nm{color:var(--rt-text-primary);font-size:13px;font-weight:500}
.tcard .mt{color:var(--rt-text-tertiary);font-size:11px;font-family:var(--rt-font-mono);margin-top:2px}

/* session tab nav + stat row */
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--rt-border-default)}
.tabs a{font-size:14px;color:var(--rt-text-tertiary);padding:10px 14px;border-bottom:2px solid transparent;cursor:pointer}
.tabs a:hover{color:var(--rt-text-secondary)}
.tabs a.on{color:var(--rt-text-primary);border-bottom-color:var(--rt-accent)}
.statrow{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-lg);overflow:hidden}
.statrow .st{padding:14px 18px;border-right:1px solid var(--rt-border-default)}
.statrow .st:last-child{border-right:none}
.statrow .k{font-size:12px;color:var(--rt-text-tertiary)}
.statrow .v{font-family:var(--rt-font-mono);font-size:26px;color:var(--rt-text-primary);font-weight:500;margin-top:4px}
.statrow .v small{font-size:12px;color:var(--rt-text-tertiary);font-family:var(--rt-font-sans)}

/* driver multiselect */
.dsel{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:8px}
.dchip{display:flex;align-items:center;gap:9px;background:var(--rt-bg-raised);border:1px solid var(--rt-border-default);
  border-radius:var(--rt-radius-md);padding:7px 10px;cursor:pointer;user-select:none}
.dchip:hover{border-color:var(--rt-border-strong)}
.dchip.on{border-color:var(--rt-accent-border);background:var(--rt-accent-muted)}
.dchip .box{width:15px;height:15px;border-radius:3px;border:1.5px solid var(--rt-border-strong);flex:none;display:grid;place-items:center}
.dchip.on .box{background:var(--rt-accent);border-color:var(--rt-accent);color:var(--rt-text-on-accent)}
.dchip .box svg{width:11px;height:11px;opacity:0}
.dchip.on .box svg{opacity:1}
.dchip .tm{width:3px;height:18px;border-radius:2px;flex:none}
.dchip .nm{font-size:13px;color:var(--rt-text-primary)}
.dchip .pos{margin-left:auto;font-family:var(--rt-font-mono);font-size:11px;color:var(--rt-text-tertiary)}

/* gantt */
.gantt-ax{display:flex;justify-content:space-between;font-family:var(--rt-font-mono);font-size:10px;color:var(--rt-text-tertiary);
  padding-left:130px;margin-bottom:6px}
.grow{display:grid;grid-template-columns:130px 1fr;gap:0;align-items:center;height:30px}
.grow .who{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--rt-text-primary)}
.grow .who .tm{width:3px;height:18px;border-radius:2px}
.grow .who .pos{font-family:var(--rt-font-mono);font-size:10px;color:var(--rt-text-tertiary)}
.gbar{display:flex;height:20px;border-radius:4px;overflow:hidden;border:1px solid var(--rt-border-subtle)}
.gbar .seg{display:flex;align-items:center;justify-content:center;font-family:var(--rt-font-mono);font-size:10px;color:#1A1206;font-weight:700;border-right:1px solid rgba(0,0,0,.35)}
.gbar .seg:last-child{border-right:none}
.gbar .seg.dark{color:#F4EEE6}

/* race story (MCP chat) */
.story{display:flex;flex-direction:column;gap:12px}
.story .q{align-self:flex-end;max-width:78%;background:var(--rt-accent-muted);border:1px solid var(--rt-accent-border);
  color:var(--rt-text-primary);border-radius:10px 10px 2px 10px;padding:9px 13px;font-size:13px}
.story .a{align-self:flex-start;max-width:88%;background:var(--rt-bg-raised);border:1px solid var(--rt-border-default);
  border-radius:10px 10px 10px 2px;padding:12px 14px;font-size:13px;color:var(--rt-text-secondary);line-height:1.55}
.story .a b{color:var(--rt-text-primary);font-weight:500}
.story .tools{display:flex;gap:6px;margin-top:9px;flex-wrap:wrap}
.toolpill{font-family:var(--rt-font-mono);font-size:10px;color:var(--rt-text-tertiary);background:var(--rt-bg-inset);
  border:1px solid var(--rt-border-subtle);border-radius:var(--rt-radius-pill);padding:2px 8px}

/* correlation timeline lanes */
.corr{display:flex;flex-direction:column;gap:1px}
.lane{display:grid;grid-template-columns:96px 1fr;gap:10px;align-items:center;min-height:34px}
.lane .lbl{font-size:11px;color:var(--rt-text-tertiary);text-align:right;text-transform:uppercase;letter-spacing:.04em}
.lane .track2{position:relative;height:26px;background:var(--rt-bg-inset);border:1px solid var(--rt-border-subtle);border-radius:4px}
.lane .band2{position:absolute;top:0;height:100%;opacity:.5}
.lane .pt{position:absolute;top:50%;transform:translate(-50%,-50%);width:9px;height:9px;border-radius:50%;border:2px solid var(--rt-bg-inset)}
.corr .corrline{position:absolute;width:2px;background:var(--rt-cursor);opacity:.7}

@media(max-width:900px){.layout{grid-template-columns:1fr}.nav{display:none}.main{padding:24px}
  .statrow{grid-template-columns:1fr 1fr}
  .grid2,.grid3{grid-template-columns:1fr}.dodont{grid-template-columns:1fr}}
</style>
</head>
