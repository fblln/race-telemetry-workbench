<?xml version="1.0" encoding="UTF-8" ?>
<!--
  PROPOSAL — not wired into the build.

  This is LauncherPage.xaml REDUCED to a ContentView that lives inside ConsoleShellPage's
  ContentHost. Everything that duplicated the shell has been REMOVED and relocated:

    REMOVED from launcher                ->  NOW PROVIDED BY THE PERSISTENT SHELL
    -------------------------------------    -----------------------------------------
    "Open a session" header + big search ->  command bar (breadcrumb + one search field)
    left SELECTION summary column        ->  breadcrumb (year/circuit/session) + HUD (driver count)
    footer "2025 · Monza · …" summary     ->  HUD strip
    its own ⌘K target                     ->  the single global palette

  What REMAINS here is only the canvas: the year -> circuit -> session -> drivers funnel,
  plus the one amber primary (Open replay) on a sticky footer. The item templates are
  unchanged from today's LauncherPage.xaml — paste them back verbatim.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaceTelemetry.Desktop.ViewModels"
             xmlns:contracts="clr-namespace:RaceTelemetry.Contracts;assembly=RaceTelemetry.Contracts"
             x:Class="RaceTelemetry.Desktop.Views.LauncherView"
             x:Name="Root"
             x:DataType="vm:ConsoleShellViewModel">

    <Grid RowDefinitions="*,Auto" Padding="0">

        <!-- ===== Funnel canvas (scrolls) ===== -->
        <ScrollView Grid.Row="0" Orientation="Vertical" VerticalScrollBarVisibility="Always" Padding="22,18,22,0">
            <VerticalStackLayout Spacing="6">

                <!-- STEP 1 · YEAR -->
                <Label Text="YEAR" Style="{StaticResource MicroLabel}" Margin="0,6,0,9" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <FlexLayout Direction="Row" Wrap="NoWrap" BindableLayout.ItemsSource="{Binding Years}">
                        <!-- paste the existing YearChoice DataTemplate here (unchanged) -->
                    </FlexLayout>
                </ScrollView>

                <!-- STEP 2 · CIRCUIT (5-up grid, 132–246px cards per density tokens) -->
                <Label Text="CIRCUIT" Style="{StaticResource MicroLabel}" Margin="0,20,0,9" />
                <ScrollView HeightRequest="{StaticResource LauncherCircuitGridHeight}" Orientation="Vertical">
                    <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding Circuits}">
                        <BindableLayout.EmptyView>
                            <Label Text="No sessions. Start the Query API and press Retry." Style="{StaticResource Caption}" />
                        </BindableLayout.EmptyView>
                        <!-- paste the existing CircuitChoice DataTemplate here (unchanged) -->
                    </FlexLayout>
                </ScrollView>

                <!-- STEP 3 · SESSION -->
                <Label Text="SESSION" Style="{StaticResource MicroLabel}" Margin="0,20,0,9" />
                <CollectionView ItemsSource="{Binding Sessions}" SelectionMode="Single"
                                SelectedItem="{Binding SelectedSession}" HeightRequest="56" HorizontalOptions="Start">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <!-- paste the existing SessionSummary DataTemplate here (unchanged) -->
                </CollectionView>

                <!-- STEP 4 · DRIVERS -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,22,0,9">
                    <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                        <Label Text="DRIVERS" Style="{StaticResource MicroLabel}" Margin="0" VerticalOptions="Center" />
                        <Label Text="{Binding DriverHeader}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="All" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllDriversCommand}" />
                    <Button Grid.Column="2" Text="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearDriversCommand}" />
                </Grid>
                <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding Drivers}" Margin="0,0,0,90">
                    <!-- paste the existing DriverChoice DataTemplate here (unchanged) -->
                </FlexLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Sticky footer: the one amber primary (§3.1). Summary now lives in the HUD,
                  so this is just the commit action. ===== -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource BgSurface}" Padding="22,14" ColumnDefinitions="*,Auto">
            <BoxView Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource BorderDefault}" VerticalOptions="Start" Margin="0,-14,0,0" />
            <Label Grid.Column="0" VerticalOptions="Center" FontFamily="JetBrainsMono" FontSize="{StaticResource FsSm}"
                   TextColor="{StaticResource TextTertiary}" Text="{Binding SelectionHint}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinimumHeightRequest="48" Padding="22,12"
                    Text="{Binding SelectedDriverCount, StringFormat='▶  Open replay ({0})'}"
                    Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" />
        </Grid>
    </Grid>
</ContentView>
