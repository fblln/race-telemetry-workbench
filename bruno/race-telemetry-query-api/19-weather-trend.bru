meta {
  name: Weather Trend
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/weather/trend
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fromMs": {{fromMs}},
    "durationMs": {{contextDurationMs}}
  }
}
