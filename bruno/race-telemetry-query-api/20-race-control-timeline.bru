meta {
  name: Race Control Timeline
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/race-control/timeline
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "search": "drs",
    "limit": 100
  }
}
