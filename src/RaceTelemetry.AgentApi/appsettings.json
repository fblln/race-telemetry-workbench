{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TelemetryAgent": {
    "McpEndpoint": "http://localhost:5122/mcp",
    "SessionIdleTimeout": "01:00:00",
    "MaximumSessions": 250,
    "MaximumMessageCharacters": 20000,
    "RunTimeout": "00:02:00",
    "SessionCleanupInterval": "00:05:00",
    "MaxContextMessages": 20
  }
}
