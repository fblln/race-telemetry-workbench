<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RaceTelemetry.Desktop"
             x:Class="RaceTelemetry.Desktop.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Theme.Carbon.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:IsNotNullConverter x:Key="IsNotNull" />
            <local:DashIfEmptyConverter x:Key="DashIfEmpty" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
