<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaceTelemetry.Desktop.ViewModels"
             xmlns:svc="clr-namespace:RaceTelemetry.Contracts;assembly=RaceTelemetry.Contracts"
             xmlns:controls="clr-namespace:RaceTelemetry.Desktop.Controls"
             x:Class="RaceTelemetry.Desktop.Views.TrackIncidentsView"
             x:DataType="vm:TrackIncidentsViewModel">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Track incidents &amp; hard-braking" Style="{StaticResource H1}" FontSize="{StaticResource FsLg}" />
            <Label Text="Hard-braking hotspots on the data-derived outline · backed by /incidents (§6.13)" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="1.3*,*" ColumnSpacing="14">

            <!-- Map -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid RowDefinitions="Auto,*">
                    <Label Grid.Row="0" Text="Incident map" Style="{StaticResource PanelTitle}" Margin="12,8" />
                    <GraphicsView Grid.Row="1" x:Name="MapView" BackgroundColor="{StaticResource BgInset}" />
                </Grid>
            </Border>

            <!-- Incident list -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Label Grid.Row="0" Text="Incidents" Style="{StaticResource PanelTitle}" Margin="12,8" />

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Incidents}"
                                    SelectionMode="Single" SelectedItem="{Binding Selected}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="svc:Incident">
                                <Grid ColumnDefinitions="46,*,Auto" Padding="10,7" ColumnSpacing="9">
                                    <Label Text="{Binding LapNumber, StringFormat='L{0}'}" FontFamily="JetBrainsMono"
                                           FontSize="{StaticResource Fs2xs}" TextColor="{StaticResource TextTertiary}"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{Binding Type}" FontFamily="InterMedium"
                                               FontSize="{StaticResource FsXs}" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding Message}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Severity}" Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No incidents loaded." Style="{StaticResource Caption}" Padding="10" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Padding="12" ColumnSpacing="8"
                          BackgroundColor="{StaticResource BgRaised}">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="HARDEST BRAKE" Style="{StaticResource MicroLabel}" />
                            <Label Text="{Binding Summary.HardestBrakingG, StringFormat='{0} g'}" Style="{StaticResource Numeric}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="INCIDENTS" Style="{StaticResource MicroLabel}" />
                            <Label Text="{Binding Summary.IncidentCount}" Style="{StaticResource Numeric}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="LAPS (SC)" Style="{StaticResource MicroLabel}" />
                            <Label Text="{Binding Summary.LapsUnderSafetyCar}" Style="{StaticResource Numeric}" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>
