<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaceTelemetry.Desktop.ViewModels"
             x:Class="RaceTelemetry.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource AppPagePadding}" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Overview" Style="{StaticResource H1}" FontSize="{StaticResource FsLg}" />
                <Label Text="Race result, fastest lap, and full classification." Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <Border Style="{StaticResource Panel}" Padding="0">
                <Grid Padding="18,16" ColumnDefinitions="64,*" ColumnSpacing="18">
                    <Border Grid.Column="0" Stroke="{StaticResource BorderDefault}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource BgInset}"
                            WidthRequest="64" HeightRequest="64">
                        <Grid RowDefinitions="*,4">
                            <Label Text="{Binding Winner.DriverCode}" FontFamily="JetBrainsMonoMedium"
                                   TextColor="{StaticResource TextPrimary}" FontSize="{StaticResource FsSm}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <BoxView Grid.Row="1" Color="{Binding Winner.RailColor}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                        <Label Text="{Binding Winner.Label}" Style="{StaticResource PanelTitle}" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding Winner.DriverName}" TextColor="{StaticResource TextPrimary}"
                               FontFamily="InterSemiBold" FontSize="{StaticResource FsXl}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Winner.Value}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsMd}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="0">
                <Grid Padding="18,16" ColumnDefinitions="64,*" ColumnSpacing="18">
                    <Border Grid.Column="0" Stroke="{StaticResource BorderDefault}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource BgInset}"
                            WidthRequest="64" HeightRequest="64">
                        <Grid RowDefinitions="*,4">
                            <Label Text="{Binding PolePosition.DriverCode}" FontFamily="JetBrainsMonoMedium"
                                   TextColor="{StaticResource TextPrimary}" FontSize="{StaticResource FsSm}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <BoxView Grid.Row="1" Color="{Binding PolePosition.RailColor}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                        <Label Text="{Binding PolePosition.Label}" Style="{StaticResource PanelTitle}" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding PolePosition.DriverName}" TextColor="{StaticResource TextPrimary}"
                               FontFamily="InterSemiBold" FontSize="{StaticResource FsXl}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding PolePosition.Value}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsMd}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
                <Grid Padding="18,16" ColumnDefinitions="64,*" ColumnSpacing="18">
                    <Border Grid.Column="0" Stroke="{StaticResource BorderDefault}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource BgInset}"
                            WidthRequest="64" HeightRequest="64">
                        <Grid RowDefinitions="*,4">
                            <Label Text="{Binding FastestLap.DriverCode}" FontFamily="JetBrainsMonoMedium"
                                   TextColor="{StaticResource TextPrimary}" FontSize="{StaticResource FsSm}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <BoxView Grid.Row="1" Color="{Binding FastestLap.RailColor}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                        <Label Text="{Binding FastestLap.Label}" Style="{StaticResource PanelTitle}" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding FastestLap.DriverName}" TextColor="{StaticResource TextPrimary}"
                               FontFamily="InterSemiBold" FontSize="{StaticResource FsXl}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding FastestLap.Value}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsMd}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <Grid RowDefinitions="Auto,Auto,*">
                <Label Grid.Row="0" Text="Full classification" TextColor="{StaticResource TextPrimary}"
                       FontFamily="InterSemiBold" FontSize="{StaticResource FsLg}" Padding="16,16,16,14" />
                <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="54,2.3*,2*,.8*,1.4*,1.3*,.8*,.8*,.7*,.8*"
                          Padding="14,10" ColumnSpacing="12">
                        <Label Text="Pos" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="1" Text="Driver" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="2" Text="Team" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="3" Text="Grid" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="4" Text="Time / Gap" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="5" Text="Fastest Lap" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="6" Text="Stints" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="7" Text="Laps" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="8" Text="Pts" Style="{StaticResource MicroLabel}" />
                        <Label Grid.Column="9" Text="Status" Style="{StaticResource MicroLabel}" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Classification}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClassificationRow">
                                <Grid ColumnDefinitions="54,2.3*,2*,.8*,1.4*,1.3*,.8*,.8*,.7*,.8*"
                                      Padding="14,9" ColumnSpacing="12" BackgroundColor="{StaticResource BgInset}">
                                    <Label Text="{Binding Position}" TextColor="{StaticResource TextPrimary}" FontFamily="JetBrainsMono" VerticalOptions="Center" />
                                    <Grid Grid.Column="1" ColumnDefinitions="3,44,*" ColumnSpacing="10">
                                        <BoxView Color="{Binding RailColor}" WidthRequest="3" HeightRequest="24" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Stroke="{StaticResource BorderDefault}" StrokeShape="RoundRectangle 18"
                                                WidthRequest="34" HeightRequest="34" BackgroundColor="{StaticResource BgRaised}">
                                            <Label Text="{Binding DriverCode}" FontFamily="JetBrainsMonoMedium"
                                                   FontSize="{StaticResource Fs2xs}" TextColor="{StaticResource TextPrimary}"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <Label Grid.Column="2" Text="{Binding DriverName}" TextColor="{StaticResource TextPrimary}"
                                               FontFamily="InterSemiBold" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Grid.Column="2" Text="{Binding TeamName}" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Grid}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsSm}" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding TimeOrGap}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsSm}" VerticalOptions="Center" />
                                    <Label Grid.Column="5" Text="{Binding FastestLap}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsSm}"
                                           TextColor="{Binding IsFastestLap, Converter={StaticResource BoolColor}, ConverterParameter='#E86BE0;#F4EEE6'}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="6" Text="{Binding Stints}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsSm}" VerticalOptions="Center" />
                                    <Label Grid.Column="7" Text="{Binding Laps}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsSm}" VerticalOptions="Center" />
                                    <Label Grid.Column="8" Text="{Binding PointsText}" Style="{StaticResource Numeric}" FontSize="{StaticResource FsSm}" VerticalOptions="Center" />
                                    <Label Grid.Column="9" Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
