<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaceTelemetry.Desktop.ViewModels"
             xmlns:svc="clr-namespace:RaceTelemetry.Contracts;assembly=RaceTelemetry.Contracts"
             x:Class="RaceTelemetry.Desktop.Views.FieldView"
             x:DataType="vm:FieldViewViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource AppPagePadding}" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Field view — all drivers" Style="{StaticResource H1}" FontSize="{StaticResource FsLg}" />
            <Label Text="Timing tower · sortable · backed by /standings (§6.11)" Style="{StaticResource Caption}" />
            <Label Text="{Binding Error}" TextColor="{StaticResource SemDanger}"
                   IsVisible="{Binding Error, Converter={StaticResource IsNotNull}}" />
        </VerticalStackLayout>

        <!-- Header -->
        <Grid Grid.Row="1" ColumnDefinitions="44,2*,80,80,80,70,50,40"
              Padding="10,6" BackgroundColor="{StaticResource BgRaised}" ColumnSpacing="6">
            <Label Text="POS" Style="{StaticResource MicroLabel}" />
            <Label Grid.Column="1" Text="DRIVER" Style="{StaticResource MicroLabel}" />
            <Label Grid.Column="2" Text="GAP" Style="{StaticResource MicroLabel}" HorizontalOptions="End" />
            <Label Grid.Column="3" Text="LAST" Style="{StaticResource MicroLabel}" HorizontalOptions="End" />
            <Label Grid.Column="4" Text="BEST" Style="{StaticResource MicroLabel}" HorizontalOptions="End" />
            <Label Grid.Column="5" Text="TYRE" Style="{StaticResource MicroLabel}" />
            <Label Grid.Column="6" Text="PIT" Style="{StaticResource MicroLabel}" HorizontalOptions="End" />
            <Label Grid.Column="7" Text="" Style="{StaticResource MicroLabel}" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:StandingRow">
                    <Grid ColumnDefinitions="44,2*,80,80,80,70,50,40" Padding="10,5" ColumnSpacing="6">
                        <Label Text="{Binding Position}" FontFamily="JetBrainsMonoMedium"
                               TextColor="{StaticResource TextPrimary}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <BoxView WidthRequest="3" HeightRequest="14" CornerRadius="1.5"
                                     Color="{Binding DriverCode, Converter={StaticResource DriverColor}}"
                                     VerticalOptions="Center" />
                            <Label Text="{Binding DriverCode}" FontFamily="JetBrainsMonoMedium"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Text="{Binding FullName}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="2" Text="{Binding GapToLeaderMs, Converter={StaticResource Gap}}"
                               FontFamily="JetBrainsMono" TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                        <Label Grid.Column="3" Text="{Binding LastLapMs, Converter={StaticResource LapTime}}"
                               FontFamily="JetBrainsMono" HorizontalOptions="End"
                               TextColor="{Binding IsPersonalBestLap, Converter={StaticResource BoolColor}, ConverterParameter='#27D98C;#BCB1A2'}" />
                        <Label Grid.Column="4" Text="{Binding BestLapMs, Converter={StaticResource LapTime}}"
                               FontFamily="JetBrainsMono" HorizontalOptions="End"
                               TextColor="{Binding IsSessionBestLap, Converter={StaticResource BoolColor}, ConverterParameter='#B98CFF;#BCB1A2'}" />
                        <Label Grid.Column="5" FontFamily="JetBrainsMono" TextColor="{StaticResource TextTertiary}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="Compound" />
                                    <Binding Path="TyreLife" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Grid.Column="6" Text="{Binding PitCount}" FontFamily="JetBrainsMono"
                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                        <Label Grid.Column="7" Text="●" HorizontalOptions="Center"
                               TextColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="No standings yet — start the Query API and open an imported session."
                       Style="{StaticResource Caption}" Padding="10" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentView>
