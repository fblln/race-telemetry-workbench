<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaceTelemetry.Desktop.ViewModels"
             x:Class="RaceTelemetry.Desktop.Controls.CommandPalette"
             x:Name="Root"
             x:DataType="vm:CommandPaletteViewModel"
             IsVisible="{Binding IsOpen}"
             InputTransparent="False">

    <!-- Dimmed faux-viewport backdrop (§2a). Tapping the backdrop closes the palette. -->
    <Grid BackgroundColor="#D8100D0B">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseCommand}" />
        </Grid.GestureRecognizers>

        <Border WidthRequest="820" Margin="0,90,0,0"
                VerticalOptions="Start" HorizontalOptions="Center"
                BackgroundColor="{StaticResource BgOverlay}"
                Stroke="{StaticResource BorderStrong}" StrokeThickness="1"
                StrokeShape="RoundRectangle 12">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.5" Radius="28" Offset="0,12" />
            </Border.Shadow>
            <!-- Swallow taps inside the card so the backdrop recognizer doesn't close it. -->
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="0">
                <!-- Query field: leading magnifier · input · ESC hint -->
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20,18" ColumnSpacing="16">
                    <Label Grid.Column="0" Text="⌕" FontSize="30" TextColor="{StaticResource TextTertiary}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1" x:Name="QueryEntry"
                           Placeholder="Jump to a session, driver, or view…"
                           FontSize="{StaticResource FsXl}"
                           Text="{Binding Query}"
                           BackgroundColor="Transparent"
                           ReturnCommand="{Binding ActivateSelectedCommand}" />
                    <Border Grid.Column="2" BackgroundColor="{StaticResource BgRaised}"
                            Stroke="{StaticResource BorderDefault}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 5" Padding="9,4" VerticalOptions="Center">
                        <Label Text="ESC" FontFamily="JetBrainsMono" FontSize="{StaticResource FsXs}"
                               TextColor="{StaticResource TextTertiary}" />
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" />

                <ScrollView MaximumHeightRequest="560">
                    <VerticalStackLayout Padding="0,4,0,8" Spacing="0">

                        <!-- SESSIONS -->
                        <Grid ColumnDefinitions="Auto,*" Padding="20,14,20,6" ColumnSpacing="8"
                              IsVisible="{Binding HasSessions}">
                            <Label Grid.Column="0" Text="⚡" FontSize="12" TextColor="{StaticResource TextTertiary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="SESSIONS" Style="{StaticResource MicroLabel}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SessionItems}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteItem">
                                    <Grid ColumnDefinitions="3,Auto,*,Auto" ColumnSpacing="12"
                                          BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolColor}, ConverterParameter='#2A241F;#00000000'}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.ExecuteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <BoxView Grid.Column="0" Color="{StaticResource Accent}" IsVisible="{Binding IsSelected}" />
                                        <Border Grid.Column="1" WidthRequest="50" HeightRequest="36" Margin="16,10,0,10"
                                                BackgroundColor="{StaticResource BgInset}"
                                                Stroke="{StaticResource BorderDefault}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 5" VerticalOptions="Center">
                                            <Label Text="{Binding Flag}" FontSize="24"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2" Padding="0,11" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" TextColor="{StaticResource TextPrimary}"
                                                   FontFamily="InterMedium" FontSize="{StaticResource FsLg}" />
                                            <Label Text="{Binding Subtitle}" FontFamily="JetBrainsMono"
                                                   FontSize="{StaticResource FsXs}" TextColor="{StaticResource TextTertiary}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="8" Padding="0,0,18,0"
                                                               VerticalOptions="Center" IsVisible="{Binding IsSelected}">
                                            <Label Text="Open" FontFamily="JetBrainsMono" FontSize="{StaticResource FsXs}"
                                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                            <Border BackgroundColor="{StaticResource BgRaised}" Stroke="{StaticResource BorderDefault}"
                                                    StrokeThickness="1" StrokeShape="RoundRectangle 5" Padding="8,3">
                                                <Label Text="↵" FontFamily="JetBrainsMono" FontSize="{StaticResource FsXs}"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- QUICK ACTIONS -->
                        <Grid ColumnDefinitions="Auto,*" Padding="20,14,20,6" ColumnSpacing="8"
                              IsVisible="{Binding HasActions}">
                            <Label Grid.Column="0" Text="❖" FontSize="12" TextColor="{StaticResource TextTertiary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="QUICK ACTIONS" Style="{StaticResource MicroLabel}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActionItems}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteItem">
                                    <Grid ColumnDefinitions="3,Auto,*,Auto" ColumnSpacing="12"
                                          BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolColor}, ConverterParameter='#2A241F;#00000000'}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.ExecuteCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <BoxView Grid.Column="0" Color="{StaticResource Accent}" IsVisible="{Binding IsSelected}" />
                                        <Border Grid.Column="1" WidthRequest="42" HeightRequest="36" Margin="16,10,0,10"
                                                BackgroundColor="{StaticResource BgInset}"
                                                Stroke="{StaticResource BorderDefault}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 5" VerticalOptions="Center">
                                            <Label Text="{Binding Icon}" FontSize="18" TextColor="{StaticResource TextSecondary}"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2" Padding="0,11" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" TextColor="{StaticResource TextPrimary}"
                                                   FontFamily="InterMedium" FontSize="{StaticResource FsLg}" />
                                            <Label Text="{Binding Subtitle}" FontFamily="JetBrainsMono"
                                                   FontSize="{StaticResource FsXs}" TextColor="{StaticResource TextTertiary}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="8" Padding="0,0,18,0"
                                                               VerticalOptions="Center" IsVisible="{Binding IsSelected}">
                                            <Border BackgroundColor="{StaticResource BgRaised}" Stroke="{StaticResource BorderDefault}"
                                                    StrokeThickness="1" StrokeShape="RoundRectangle 5" Padding="8,3">
                                                <Label Text="↵" FontFamily="JetBrainsMono" FontSize="{StaticResource FsXs}"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="No matches." Style="{StaticResource Caption}" Padding="20,18"
                               IsVisible="{Binding HasResults, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
