<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RaceTelemetry.Desktop"
             xmlns:components="clr-namespace:RaceTelemetry.Desktop.Components"
             x:Class="RaceTelemetry.Desktop.MainPage"
             BackgroundColor="#14110E">

    <BlazorWebView x:Name="webView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Shell}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
