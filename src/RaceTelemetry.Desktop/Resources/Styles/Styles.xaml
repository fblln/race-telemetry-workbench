<?xml version="1.0" encoding="UTF-8" ?>
<!-- Carbon Signal component styles. Built on tokens from Theme.Carbon.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Page baseline -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BgCanvas}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="ContentView" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Shell chrome: keep the nav/tab bars on-theme (graphite + amber). -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource BgCanvas}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource TextDisabled}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource BgSurface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Accent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Accent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextTertiary}" />
    </Style>

    <!-- Default activity indicator + refresh tint -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Accent}" />
    </Style>

    <!-- Text -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{StaticResource FsBase}" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FsXl}" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="{StaticResource FsSm}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontSize" Value="{StaticResource FsXs}" />
    </Style>

    <!-- Mono numeric readout -->
    <Style x:Key="Numeric" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="FontSize" Value="{StaticResource NumMd}" />
    </Style>

    <Style x:Key="MicroLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="FontSize" Value="{StaticResource Fs2xs}" />
        <!-- Subtle uppercase tracking. (CharacterSpacing of 60 blew labels out to "S E S S I O N S".) -->
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <!-- Panel container -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BgSurface}" />
        <Setter Property="Stroke" Value="{StaticResource BorderDefault}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Primary (amber) button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnAccent}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FsSm}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BgRaised}" />
                            <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BgRaised}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="{StaticResource FsSm}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- Entry / search -->
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource BgInset}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextDisabled}" />
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="FontSize" Value="{StaticResource FsSm}" />
    </Style>

</ResourceDictionary>
