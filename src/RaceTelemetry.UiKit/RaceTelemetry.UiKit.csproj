<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep component + service types under RaceTelemetry.Desktop.* so the MAUI host and
         existing usings resolve unchanged; the static-asset base stays _content/RaceTelemetry.UiKit. -->
    <RootNamespace>RaceTelemetry.Desktop</RootNamespace>
    <!-- Shared UI for both the MAUI BlazorWebView host and the Blazor Server test harness. -->
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Markdig" Version="0.41.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RaceTelemetry.Contracts\RaceTelemetry.Contracts.csproj" />
  </ItemGroup>

</Project>
